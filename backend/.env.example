# ============================================================
# whyLayer Backend - Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit .env to version control.
# ============================================================

# --- LLM API Keys ---

# Groq API key (primary LLM provider for interrogation)
GROQ_API_KEY=

# Gemini API key (secondary LLM provider, used for classification and fallback)
GEMINI_API_KEY=

# SambaNova API key (used for deep reasoning in verdicts)
SAMBANOVA_API_KEY=

# Cerebras API key (ultra-fast inference, optional)
# CEREBRAS_API_KEY=

# OpenRouter API key (fallback LLM provider, optional)
# OPENROUTER_API_KEY=

# --- Search API Keys ---

# Serper API key for Google Search (optional, fallback search provider)
# SERPER_API_KEY=

# Jina API key for neural search (optional)
# JINA_API_KEY=

# --- Google OAuth ---

# Google OAuth 2.0 Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=

# Google OAuth 2.0 Client Secret (from Google Cloud Console)
GOOGLE_CLIENT_SECRET=

# --- JWT Configuration ---

# JWT secret key for signing tokens (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=

# --- App Configuration ---

# Application environment: development | production (defaults to development)
APP_ENV=development

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
